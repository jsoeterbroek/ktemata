# Third-party material (kept locally, not redistributed)
Pi_Flux_r1_-_Build_Guide.pdf
build_guide.txt
extracted/
*.jpg
MilDef-*.png

# Downloaded reference videos (transcripts are tracked; the generator videos and their
# transcripts moved to the separate handcrank repo)
reference/yt/*.webm
reference/yt/*.mp4
reference/yt/*.mkv
reference/content/

# Python environment (uv / venv)
.venv/
__pycache__/
*.pyc

# Scratch / working files (keep the helper scripts)
work/*
!work/scripts/
!work/patches/

# content from Kiwix library
# should show a txt file with my choices
zim/*.zim

.shopping.md

# PDFs are not source: they are either rebuilt by a generator or downloaded, so a new one is a
# working file by default (see "do not include pdf's").  The exceptions are files a reader needs
# from a clean clone - the wiring diagram, and the two sticker upload files that
# `paint.py --stickers` writes.  A tracked PDF is never dropped by these rules; the exceptions
# exist so a future, broader PDF rule cannot sweep the deliverables away.
*.pdf
!docs/ktemata_r3_wiring.pdf
!docs/paint/ktemata_sticker_*.pdf
