  (wire (pts (xy 199.39 40.64) (xy 189.23 40.64)) (stroke (width 0) (type solid)) (uuid "d64d5d08-352c-5c8f-9dbc-c2efffe5edd2"))
  (global_label "GND" (shape bidirectional) (at 189.23 40.64 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "71dfa81a-c1c6-5ac7-b1c7-99d78904fcd8"))
  (text "The display is auto-detected on DSI and also needs its 3-pin power cable (DISP_5V)."
    (at 20.32 149.86 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "d655fe5f-572c-5f3f-b6c4-cd9dc3822999"))
  (text "The NVMe Base Duo takes data and power on the PCIe FFC; its standoffs carry the Pi."
    (at 20.32 158.75 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "7c455616-2acf-54e3-8916-873a5b434bc3"))
  (text "VBAT_PI is the ML-2020 on J5, with rtc_bbat_vchg=3000000 in config.txt."
    (at 20.32 167.64 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "b0e9bfe4-c79e-598f-bb0c-6adb67091ce5"))
  (text "USB_KEYBOARD is the K06 dongle in a Pi USB-A, or nothing at all over Bluetooth."
    (at 20.32 176.53 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "1d86c0c9-f2ac-560c-baa0-ff9ae11e5c3e"))
