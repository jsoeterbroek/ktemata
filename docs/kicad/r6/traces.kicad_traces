  <end x="95.25" y="68.58"/>
  <layer>0</layer>
  <description>Charge sense divider output to ADC0</description>
</trace>

<trace name="GND_power" net_name="GND" width="0.8">
  <start x="82.55" y="35.56"/>
  <end x="95.25" y="35.56"/>
  <layer>0</layer>
  <description>Power ground reference for power section</description>
</trace>

<!-- Vias -->
<vias name="Top_Via_Charge" position="[82.55 19.05]">
  <layers>Signal, Power</layers>
  <size>0.6</size>
  <description>Through-hole via for CHG_12V6_IN power input</description>
</vias>

<connections name="CHG_12V6_IN" width="0.8">
  <net name="CHG_12V6_IN" color="#00FF00"/>
  <ref>J1-PIN1</ref>
</connections>

<connections name="GND_power" width="0.8">
  <net name="GND" color="#FF0000"/>
  <ref>J1-PIN2</ref>
</connections>

<!-- Net Classes -->
<net_classes>
  <net_class name="CHG_SENSE" conditions="No nets cross over other classes"/>
  <net_class name="GND" conditions="All ground planes connect"/>
</net_classes>

