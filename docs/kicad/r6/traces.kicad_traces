<traces name="Ktemata R6 - PCH Power Distribution">

<!-- Ktemata R6 PCH (Power Distribution & Communication Hub) -->
<!-- Based on ktemata_r6_connections.csv netlist -->

<trace name="CHG_12V6_IN" net_name="CHG_12V6_IN" width="0.5">
  <start x="82.55" y="19.05"/>
  <end x="95.25" y="19.05"/>
  <layer>0</layer>
  <description>DC-099 input to J3 latching switch</description>
</trace>

<trace name="CHG_SENSE" net_name="CHG_SENSE" width="0.3">
