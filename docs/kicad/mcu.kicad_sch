  (text "The FireBeetle is the only I2C master: do not connect this bus to the Pi."
    (at 20.32 149.86 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "461aebd5-5481-5cf7-a8c8-12e3c41bd3ba"))
  (text "Fit one set of pull-ups only. I2C and the sense divider are 3.3 V."
    (at 20.32 158.75 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "44e5785a-df0d-59b4-bd04-5214155bfe70"))
  (text "A0 is ADC1_CH0 (GPIO36); GPIO4 is the OLED button, INPUT_PULLUP."
    (at 20.32 167.64 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "2fdba320-5548-532d-9dc9-22878e7aff29"))
  (text "USB_FB_SERIAL is a data-only cable: the board runs from the HAT's USB-A."
    (at 20.32 176.53 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "df5d08e7-53e0-5d82-ab81-301642bf794c"))
